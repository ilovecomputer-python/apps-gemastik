DATABASE_URL="postgresql://aura:aura_dev_password@localhost:5432/aura?schema=public"
# Session-mode connection used by Prisma Migrate. On plain local Postgres this
# is the same as DATABASE_URL; on Supabase use port 5432 (not the 6543 pooler).
DIRECT_URL="postgresql://aura:aura_dev_password@localhost:5432/aura?schema=public"
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# AI Scan (Gemini vision). Get a key at https://aistudio.google.com/apikey
# Without it the server still boots; only /api/scan/* returns 503.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# Payments. Test keys at https://dashboard.stripe.com/test/apikeys
# Without them the server still boots; only /api/payments/* returns 503.
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:4000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=""
APP_URL="http://localhost:5173"
